{{template "base" .}}

{{define "title"}}snippet #{{.Snippet.ID}}{{end}}

{{define "main"}}
{{with .Snippet}}
<div class="snippet">
    <div class="metadata">
        <strong>{{.Title}}</strong>
        <span>#{{.ID}}</span>
    </div>
    <pre><code>{{.Content}}</code></pre>
    <div class="metadata">
        <time>created: {{humanDate .Created}}</time>
        <time>expires: {{humanDate .Expires}}</time>
    </div>
</div>
{{end}}
{{end}}